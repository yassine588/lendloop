# ==============================================================================
# LendLoop Environment Variables (.env.example)
# Copy this file to .env.local and fill in your credentials.
# Never commit .env or .env.local to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Convex Configuration
# ------------------------------------------------------------------------------
# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment-name
# Public Convex query/mutation URL (e.g. https://your-deployment.convex.cloud)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Convex HTTP Actions URL (e.g. https://your-deployment.convex.site)
CONVEX_SITE_URL=https://your-deployment.convex.site

# ------------------------------------------------------------------------------
# 2. Clerk Authentication
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Clerk JWT Issuer Domain configured in Convex (e.g. https://your-clerk-domain.clerk.accounts.dev)
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev

# Optional comma-separated list of admin email addresses for initial admin bootstrap
# (Configure in Convex dashboard environment variables: `npx convex env set ADMIN_EMAILS "..."`)
ADMIN_EMAILS=admin@lendloop.local

# ------------------------------------------------------------------------------
# 3. n8n Workflow Automation & Bidirectional HMAC Security
# ------------------------------------------------------------------------------
# Shared 256-bit secret (hex or base64) used to sign and verify HMAC-SHA256
# payloads in BOTH directions (Convex -> n8n and n8n -> Convex HTTP Actions).
# Generate with: `openssl rand -hex 32`
LENDLOOP_WEBHOOK_SECRET=replace_with_32_byte_hex_hmac_shared_secret

# Outbound webhook URL in n8n triggered when borrow requests are created or updated
# (Set in Convex environment variables: `npx convex env set N8N_REQUEST_WEBHOOK_URL "..."`)
N8N_REQUEST_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-loan-event

# ------------------------------------------------------------------------------
# 4. Docker Compose (Self-Hosted n8n) Variables
# ------------------------------------------------------------------------------
N8N_ENCRYPTION_KEY=replace_with_random_n8n_encryption_key
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# Notification recipient override / SMTP settings for n8n workflows
OPS_ALERT_EMAIL=ops@lendloop.local
